# DB only Postgresql
POSTGRES_DB='grms'
POSTGRES_USER='grms_user'  # It is strongly recommended to change
POSTGRES_PASSWORD='grms_password'  # It is strongly recommended to change
POSTGRES_HOST='postgres'
POSTGRES_PORT='5432'

# Server
GUNICORN_WORKERS=4
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=30

# BACKEND
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost
DJANGO_CORS_ORIGIN_WHITELIST=http://localhost:5173
DJANGO_SECRET_KEY=DJANGO_SECRET_KEY
DJANGO_GATEWAYS_MONITORING='47aef21b-6cc9-4ec5-8573-1a6f491940c0'
HOTEZA_WHITELIST='1.1.1.1'
CLIENT_TOKENS='client_token1 client_token2'
# Logging
DJANGO_LOG_LEVEL=WARNING
DJANGO_LOG_FORMATTER=simple
DJANGO_LOG_SQL=false

CELERY_BROKER_URL='redis://redis:6379/0'
CHANNEL_LAYERS_HOST='redis://redis:6379/0'
REDIS_HOST='redis'
CACHE_LOCATION='redis://redis:6379/1'

# RabbitMQ credentials
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_LOGIN=guest
RABBIT_PASSWORD=guest

# RabbitMQ configs
RABBITMQ_DEFAULT_USER=rmuser
RABBITMQ_DEFAULT_PASS=rmpassword
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=-rabbit log_levels [{connection,error},{default,error}] disk_free_limit 2147483648

# Cloudflare Turnstile CAPTCHA
TURNSTILE_ENABLED=False
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=


# FRONTEND
VITE_API_BASE_URL=http://localhost:9000/api/v1
VITE_WS_BASE_URL=ws://localhost:9000/api/ws/


# NetBird integration
NETBIRD_API_URL=https://netbird.example.com/api
NETBIRD_MANAGEMENT_URL=https://netbird.example.com:443
NETBIRD_PAT=nbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NETBIRD_HOTEL_GROUP_ID=
# Blank = first label of FRONTEND_DOMAIN. Must differ per deployment.
FLEET_NODE_PREFIX=
SSH_PRIVATE_KEY_PATH=~/.roomio/fleet_key
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... roomio-fleet"
SSH_USER=roomio-agent
INSTALL_TOKEN_TTL_HOURS=24
FLEET_INSTALL_BASE_URL=
