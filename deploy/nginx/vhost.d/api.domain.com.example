# Timeouts for long requests and the WebSocket handshake
proxy_connect_timeout  60s;
proxy_send_timeout     300s;
proxy_read_timeout     300s;

# Proxy headers (WebSocket upgrade, client IP, X-Forwarded-*, X-Request-ID) live in
# deploy/nginx/proxy.conf. Don't add proxy_set_header here: a single one at this
# level makes nginx drop all of those for this host.

# File uploads
client_max_body_size 50m;

# Response buffering
proxy_buffering    on;
proxy_buffer_size  8k;
proxy_buffers      16 8k;

# Security headers
add_header X-Content-Type-Options  nosniff                          always;
add_header X-Frame-Options         DENY                             always;
add_header Referrer-Policy         strict-origin-when-cross-origin  always;

# Static and media (served directly by nginx-proxy, bypassing Django)
location /static/ {
    alias      /app/static/;
    expires    1y;
    access_log off;
    add_header Cache-Control "public, immutable";
}

location /media/ {
    alias      /app/media/;
    expires    30d;
    add_header Cache-Control "public";
}
