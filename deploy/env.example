# =============================================================================
# roomio GRMS — .env
# =============================================================================
# Copy to .env and fill in the values:
#   cp env.example .env
#
# DO NOT commit .env to git!
# =============================================================================

# --- Compose ---
COMPOSE_PROJECT_NAME=roomio

# --- Image tags ---
BACKEND_IMAGE_TAG=dev
FRONT_IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_USER=roomio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=roomio_db
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433    # external postgres port (dev only, override)
PGBOUNCER_EXTERNAL_PORT=6432   # external pgbouncer port (dev only, override)

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379          # external redis port (dev only, override)
REDIS_BROKER_EXTERNAL_PORT=6380   # external redis-broker port (dev only, override)

# --- RabbitMQ (container settings) ---
RABBITMQ_DEFAULT_USER=roomio
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=

# --- RabbitMQ (connection from Django) ---
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_LOGIN=roomio
RABBIT_PASSWORD=change_me

# --- Celery Flower (worker monitoring, http://127.0.0.1:5555) ---
FLOWER_BASIC_AUTH=admin:change_me

# --- Django ---
DJANGO_SECRET_KEY=change_me_use_50_char_random_string
DJANGO_DEBUG=False
# The lists below are separated by a SPACE (not a comma), see settings.py .split(" ")
DJANGO_ALLOWED_HOSTS=api.domain.com localhost
DJANGO_CORS_ORIGIN_WHITELIST=https://domain.com http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=https://domain.com https://api.domain.com
DJANGO_LOG_LEVEL=INFO # DEBUG INFO WARNING ERROR
DJANGO_LOG_FORMATTER=verbose # simple verbose verbose_with_location
DJANGO_LOG_SQL=0 # 0 1
FRONTEND_DOMAIN=https://domain.com

# --- Django optional ---
HOTEZA_WHITELIST=                    # space-separated list
CLIENT_TOKENS=                       # space-separated list
DJANGO_IS_MONITORING_GATEWAYS='' # 1, true, yes
DJANGO_MONITORING_EXCLUDED_GATEWAYS=
TIME_ZONE=UTC
WS_INTERVAL=5                        # WebSocket telemetry interval, sec

# Headers trusted for the client IP (Hoteza whitelist, brute-force protection, login).
# Comma-separated, checked in order; empty = REMOTE_ADDR only. Unset defaults to
# CF-Connecting-IP,X-Real-IP, so a client could forge CF-Connecting-IP and bypass
# the whitelist unless Cloudflare proxies the API. Behind Cloudflare: CF-Connecting-IP,X-Real-IP
TRUSTED_IP_HEADERS=X-Real-IP

# --- Email ---
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_HOST_USER=change_me
EMAIL_HOST_PASSWORD=change_me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=change_me
EMAIL_TIMEOUT=30                     # таймаут SMTP, сек (письма об авариях, сброс пароля)
COMPANY_NAME=change_me

# --- SSO / OAuth ---
KEYCLOAK_BASE_URL=https://sso.domain.com
KEYCLOAK_REALM=roomio
KEYCLOAK_CLIENT_ID=change_me
KEYCLOAK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me

MS_CLIENT_ID=change_me
MS_CLIENT_SECRET=change_me

# --- Cloudflare Turnstile ---
TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WebRTC ---
WEBRTC_BROKER_URL=https://webrtc.domain.com

# --- Virtual hosts (nginx-proxy) ---
API_VIRTUAL_HOST=api.domain.com
FRONTEND_VIRTUAL_HOST=domain.com
LETSENCRYPT_EMAIL=change_me@domain.com

# --- Frontend (Vite) ---
VITE_API_BASE_URL=https://api.domain.com
VITE_WS_BASE_URL=wss://api.domain.com/ws
VITE_WS_BASE_URL_V2=wss://api.domain.com/ws/v2
VITE_ROOMIO_AI_BASE_URL=https://ai.domain.com

# --- MQTT ---
MQTT_EXTERNAL_PORT=9000

# --- Node-RED (single instance via profile) ---
NODERED_VIRTUAL_HOST=nodered.domain.com
NODERED_EXTERNAL_PORT=1880
NODERED_TENANT_ID=change_me

# --- Node-RED provisioning (automatic on tenant creation) ---
# On tenant creation celery-low creates a CNAME on the domain from NODERED_BASE_DOMAIN,
# writes .env.nodered.<slug> and runs docker compose up; on delete_tenant it tears it down.
NODERED_PROVISIONING_ENABLED=False
# API token with Zone.DNS:Edit permission and the ID of the zone that holds NODERED_BASE_DOMAIN
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Tenant domain: <slug>.nodered.<NODERED_BASE_DOMAIN>, the nodered label is added automatically.
# Empty = host from FRONTEND_DOMAIN. E.g. bukhara.cloud -> flamingo.nodered.bukhara.cloud.
# The domain must be inside the CLOUDFLARE_ZONE_ID zone: Cloudflare treats a foreign name
# as relative and appends the zone to the end.
NODERED_BASE_DOMAIN=
# Where the CNAME points; empty = API_VIRTUAL_HOST.
# The target must NOT be proxied by Cloudflare (grey cloud) and must lead to this server:
# through a proxied name the request goes to the Cloudflare edge and returns error 1001,
# and Let's Encrypt fails the HTTP-01 challenge.
NODERED_DNS_TARGET=
# Directory with docker config.json (docker login to registry.gitlab.com); empty = ~/.docker
DOCKER_CONFIG_DIR=

# --- Fleet / NetBird ---
# See docs/fleet-server-setup.md. NETBIRD_HOTEL_GROUP_ID is the group *ID*, not its name.
NETBIRD_API_URL=https://netbird.domain.com/api
NETBIRD_MANAGEMENT_URL=https://netbird.domain.com:443
NETBIRD_PAT=nbp_change_me
NETBIRD_HOTEL_GROUP_ID=change_me
NETBIRD_SETUP_KEY_TTL=3600
# Leading part of every node code / NetBird hostname. Blank = first label of
# FRONTEND_DOMAIN (cloud.room.io -> cloud). Must differ per deployment.
FLEET_NODE_PREFIX=

SSH_PRIVATE_KEY_PATH=/etc/roomio/fleet_key
FLEET_SSH_KEY_PATH=/etc/roomio/fleet_key
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... roomio-fleet"
SSH_USER=roomio-agent
SSH_PORT=22
FLEET_INSTALL_BASE_URL=
INSTALL_TOKEN_TTL_HOURS=24

FLEET_UPLOAD_ROOT=
FLEET_UPLOAD_MAX_BYTES=104857600
FLEET_UPLOAD_TIMEOUT=300

# Bulk jobs across nodes. FLEET_GATEWAY_SERVICE is the systemd unit the
# gateway runs as on a node — the catalog's gateway actions target it.
FLEET_GATEWAY_SERVICE=roomio-gateway
FLEET_JOB_CONCURRENCY=5
FLEET_JOB_MAX_NODES=200
FLEET_JOB_OUTPUT_LIMIT=65536
FLEET_JOB_TIMEOUT=1800
# --- Alarms (ThingsBoard-style alarm rules on device profiles) ---
# ALARMS_ENABLED=false stops the evaluator and the dispatcher without a rollback.
ALARMS_ENABLED=true
# Evaluator period, and therefore the worst-case delay before an alarm appears.
ALARMS_EVAL_INTERVAL_SEC=30
# Cleared alarms older than this are purged nightly; open ones never are.
ALARMS_TTL_DAYS=365

# One bot for the whole installation; each tenant configures only its chat id,
# from the panel. Unrelated to the TELEGRAM_* pair in deploy/monitoring/env.example,
# which belongs to Alertmanager's separate stack — the same bot may be reused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_TIMEOUT=10

# WhatsApp Cloud API (Meta). No shared sender: every hotel enters its own
# phone number id and token in the panel and pays Meta itself. Here only the
# webhook (/api/v1/services/messengers/) and the alarm template.
# WA_VERIFY_TOKEN: any string, the same one typed into the Meta webhook form.
# WA_APP_SECRET: App settings → Basic; webhook POSTs are rejected while empty.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0
WA_TIMEOUT=10
# Approved Utility template for alarm notifications; text in alarms/channels/whatsapp.py.
WA_ALARM_TEMPLATE=alarm_summary
WA_TEMPLATE_LANGUAGE=ru
# Encrypts secrets tenants enter in the panel (a hotel's WhatsApp token).
# Empty: derived from DJANGO_SECRET_KEY, so rotating that key means re-entering
# them. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
