# =============================================================================
# roomio GRMS — .env
# =============================================================================
# Скопируй в .env и заполни значения:
#   cp env.example .env
#
# НЕ коммить .env в git!
# =============================================================================

# --- Compose ---
COMPOSE_PROJECT_NAME=roomio

# --- Image tags ---
BACKEND_IMAGE_TAG=dev
FRONT_IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_USER=roomio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=roomio_db
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433    # внешний порт postgres (только dev, override)
PGBOUNCER_EXTERNAL_PORT=6432   # внешний порт pgbouncer (только dev, override)

# --- Redis ---
REDIS_HOST=redis
REDIS_EXTERNAL_PORT=6379
REDIS_BROKER_EXTERNAL_PORT=6380
CACHE_LOCATION=redis://redis:6379/1
CHANNEL_LAYERS_HOST=redis://redis:6379/0

# --- RabbitMQ (настройки контейнера) ---
RABBITMQ_DEFAULT_USER=roomio
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=8097
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=

# --- RabbitMQ (подключение из Django) ---
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_LOGIN=roomio
RABBIT_PASSWORD=change_me

# --- Django ---
DJANGO_SECRET_KEY=change_me_use_50_char_random_string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.domain.com,localhost
DJANGO_CORS_ORIGIN_WHITELIST=https://domain.com,http://localhost:5173
DJANGO_LOG_LEVEL=WARNING
DJANGO_LOG_FORMATTER=verbose
DJANGO_LOG_SQL=0
FRONTEND_DOMAIN=https://domain.com

# --- Django опциональные ---
HOTEZA_WHITELIST=
DJANGO_GATEWAYS_MONITORING=
DJANGO_ALL_GATEWAYS_MONITORING=

# --- Email ---
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_HOST_USER=change_me
EMAIL_HOST_PASSWORD=change_me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=change_me
COMPANY_NAME=change_me

# --- SSO / OAuth ---
KEYCLOAK_BASE_URL=https://sso.domain.com
KEYCLOAK_REALM=roomio
KEYCLOAK_CLIENT_ID=change_me
KEYCLOAK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me

MS_CLIENT_ID=change_me
MS_CLIENT_SECRET=change_me

# --- Cloudflare Turnstile ---
TURNSTILE_ENABLED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WebRTC ---
WEBRTC_BROKER_URL=https://webrtc.domain.com

# --- Virtual hosts (nginx-proxy) ---
API_VIRTUAL_HOST=api.domain.com
FRONTEND_VIRTUAL_HOST=domain.com
LETSENCRYPT_EMAIL=change_me@domain.com

# --- Frontend (Vite) ---
VITE_API_BASE_URL=https://api.domain.com
VITE_WS_BASE_URL=wss://api.domain.com/ws
VITE_WS_BASE_URL_V2=wss://api.domain.com/ws/v2
VITE_ROOMIO_AI_BASE_URL=https://ai.domain.com

# --- MQTT ---
MQTT_EXTERNAL_PORT=9000

# --- Node-RED (single instance via profile) ---
NODERED_VIRTUAL_HOST=nodered.domain.com
NODERED_EXTERNAL_PORT=1880
NODERED_TENANT_ID=change_me
