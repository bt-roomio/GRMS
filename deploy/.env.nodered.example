# =============================================================================
# roomio GRMS — Node-RED tenant env
# =============================================================================
# Copy to .env.nodered.<name> and fill in:
#   cp .env.nodered.example .env.nodered.nines
#
# DO NOT commit .env.nodered.* to git!
# =============================================================================

# Tenant name, used as the container_name suffix and project-name
TENANT_NAME=nines

# Tenant UUID in GRMS
NODERED_TENANT_ID=00000000-0000-0000-0000-000000000000

# Domain for nginx-proxy
NODERED_VIRTUAL_HOST=nodered-nines.example.com

# Email for Let's Encrypt
LETSENCRYPT_EMAIL=grms@room.io

# Log level: debug | info | warn | error
NODERED_LOG_LEVEL=warn

# Timezone
TZ=Asia/Nicosia
