# =============================================================================
# roomio GRMS — Node-RED tenant env
# =============================================================================
# Скопируй в .env.nodered.<name> и заполни:
#   cp .env.nodered.example .env.nodered.nines
#
# НЕ коммить .env.nodered.* в git!
# =============================================================================

# Имя тенанта — используется как суффикс container_name и project-name
TENANT_NAME=nines

# UUID тенанта в GRMS
NODERED_TENANT_ID=00000000-0000-0000-0000-000000000000

# Домен для nginx-proxy
NODERED_VIRTUAL_HOST=nodered-nines.example.com

# Email для Let's Encrypt
LETSENCRYPT_EMAIL=grms@room.io

# Уровень логирования: debug | info | warn | error
NODERED_LOG_LEVEL=warn
