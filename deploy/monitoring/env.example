# =============================================================================
# monitoring/.env — переменные для стека мониторинга
# =============================================================================
# cp monitoring/.env.example monitoring/.env
# НЕ коммитить .env в git!
# =============================================================================

# --- Grafana ---
GRAFANA_VIRTUAL_HOST=grafana.domain.com
GRAFANA_ADMIN_PASSWORD=change_me

# --- Alertmanager / Telegram ---
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=change_me

# --- Blackbox login probe ---
BLACKBOX_LOGIN_EMAIL=change_me@domain.com
BLACKBOX_LOGIN_PASSWORD=change_me

# --- Let's Encrypt ---
LETSENCRYPT_EMAIL=change_me@domain.com
